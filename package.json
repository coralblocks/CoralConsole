{
  "name": "coral-console",
  "version": "1.4.3",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "version:set": "node scripts/set-version.mjs",
    "actors:export": "node scripts/export-actors.mjs",
    "actors:import": "node scripts/import-actors.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "release:package": "node scripts/package-release.mjs",
    "docker:build": "sh scripts/docker-command.sh build",
    "docker:backup": "sh scripts/docker-backup.sh",
    "docker:dev:logs": "sh scripts/docker-command.sh dev-logs",
    "docker:dev:rebuild": "sh scripts/docker-dev-rebuild.sh",
    "docker:dev:start": "sh scripts/docker-dev-start.sh",
    "docker:dev:stop": "sh scripts/docker-dev-stop.sh",
    "docker:release": "sh scripts/docker-release.sh",
    "docker:start": "sh scripts/docker-start.sh",
    "docker:stop": "sh scripts/docker-stop.sh",
    "docker:restart": "sh scripts/docker-command.sh restart",
    "docker:status": "sh scripts/docker-command.sh status",
    "docker:logs": "sh scripts/docker-command.sh logs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "allowScripts": {
    "better-sqlite3@13.0.1": true
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  }
}
